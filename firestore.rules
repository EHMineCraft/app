rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every document a user owns lives under users/{uid}/... — a request is
    // allowed only when the authenticated caller's UID matches that path
    // segment, so no one can read or write another account's worlds, places,
    // or categories even if they somehow learn the document IDs.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
